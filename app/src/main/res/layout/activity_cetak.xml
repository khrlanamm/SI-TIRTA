<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_tirta_light"
    tools:context=".ui.cetak.CetakActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/navy_tirta_light"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIconTint="@color/black"
            app:title="Cetak Penagihan"
            app:titleTextColor="@color/black" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Pilih Printer Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_pilih_printer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_select_printer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_pilih_printer_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Printer..."
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/text_selected_printer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_error_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="Tidak Terhubung"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Data Pelanggan -->
            <TextView
                android:id="@+id/tv_data_pelanggan_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Data Pelanggan"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_pilih_printer" />

            <!-- Item Person (re-use layout) -->
            <include
                android:id="@+id/item_pelanggan"
                layout="@layout/item_person"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_data_pelanggan_label" />


            <!-- Card Detail Tagihan -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_detail_tagihan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_pelanggan">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_detail_tagihan_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detail Tagihan Air"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Meter Bulan Lalu -->
                    <TextView
                        android:id="@+id/tv_meter_lalu_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_detail_tagihan_title"
                        tools:text="Meter Air Juni 2025:" />

                    <TextView
                        android:id="@+id/tv_meter_lalu_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/tv_meter_lalu_unit"
                        app:layout_constraintTop_toTopOf="@id/tv_meter_lalu_label"
                        app:layout_constraintBottom_toBottomOf="@id/tv_meter_lalu_label"
                        android:layout_marginEnd="4dp"
                        tools:text="713" />

                    <TextView
                        android:id="@+id/tv_meter_lalu_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_meter_lalu_label"
                        app:layout_constraintBottom_toBottomOf="@id/tv_meter_lalu_label"
                        android:text="m³" />


                    <!-- Meter Bulan Ini -->
                    <TextView
                        android:id="@+id/tv_meter_ini_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_meter_lalu_label"
                        tools:text="Meter Air Juli 2025:" />

                    <EditText
                        android:id="@+id/et_meter_ini_value"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textAlignment="textEnd"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        android:background="@drawable/edittext_background"
                        android:padding="8dp"
                        app:layout_constraintEnd_toStartOf="@id/tv_meter_ini_unit"
                        app:layout_constraintTop_toTopOf="@id/tv_meter_ini_label"
                        app:layout_constraintBottom_toBottomOf="@id/tv_meter_ini_label"
                        android:layout_marginEnd="4dp"
                        tools:text="720"/>

                    <TextView
                        android:id="@+id/tv_meter_ini_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_meter_ini_label"
                        app:layout_constraintBottom_toBottomOf="@id/tv_meter_ini_label"
                        android:text="m³" />


                    <!-- Tombol Hitung -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_hitung"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Hitung Tagihan"
                        app:cornerRadius="25dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/et_meter_ini_value" />

                    <!-- Divider -->
                    <View
                        android:id="@+id/divider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/border_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/button_hitung" />

                    <!-- Rincian Tagihan -->
                    <TextView
                        android:id="@+id/tv_meter_ditagih_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Meter Air Ditagih:"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/divider" />

                    <TextView
                        android:id="@+id/tv_meter_ditagih_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_background"
                        android:padding="8dp"
                        android:textColor="@color/text_primary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_meter_ditagih_label"
                        android:layout_marginTop="4dp"
                        tools:text="7 m³"/>

                    <TextView
                        android:id="@+id/tv_kali"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="x"
                        android:layout_marginHorizontal="8dp"
                        app:layout_constraintStart_toEndOf="@id/tv_meter_ditagih_value"
                        app:layout_constraintEnd_toStartOf="@id/tv_harga_per_meter"
                        app:layout_constraintTop_toTopOf="@id/tv_meter_ditagih_value"
                        app:layout_constraintBottom_toBottomOf="@id/tv_meter_ditagih_value"/>

                    <TextView
                        android:id="@+id/tv_harga_per_meter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_background"
                        android:padding="8dp"
                        android:text="Rp2.500"
                        android:textColor="@color/text_primary"
                        app:layout_constraintStart_toEndOf="@id/tv_kali"
                        app:layout_constraintTop_toTopOf="@id/tv_meter_ditagih_value"
                        app:layout_constraintBottom_toBottomOf="@id/tv_meter_ditagih_value"/>

                    <TextView
                        android:id="@+id/tv_total_tagihan_air_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Total Tagihan Air"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_meter_ditagih_value" />

                    <TextView
                        android:id="@+id/tv_total_tagihan_air_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_background"
                        android:padding="8dp"
                        android:textColor="@color/text_primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_total_tagihan_air_label"
                        app:layout_constraintBottom_toBottomOf="@id/tv_total_tagihan_air_label"
                        tools:text="Rp17.500" />

                    <TextView
                        android:id="@+id/tv_iuran_bulanan_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Iuran Bulanan"
                        android:textColor="@color/text_secondary"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_total_tagihan_air_label" />

                    <TextView
                        android:id="@+id/tv_iuran_bulanan_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/edittext_background"
                        android:padding="8dp"
                        android:text="Rp5.000"
                        android:textColor="@color/text_primary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_iuran_bulanan_label"
                        app:layout_constraintBottom_toBottomOf="@id/tv_iuran_bulanan_label"/>

                    <!-- Total Tagihan Bulan Ini -->
                    <TextView
                        android:id="@+id/tv_total_tagihan_bulan_ini_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_iuran_bulanan_label"
                        tools:text="Total Tagihan Bulan Juli 2025:" />

                    <TextView
                        android:id="@+id/tv_total_tagihan_bulan_ini_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/edittext_background"
                        android:padding="12dp"
                        android:textAlignment="center"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_total_tagihan_bulan_ini_label"
                        tools:text="Rp22.500" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Status Pembayaran -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_sudah_dibayar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Sudah Dibayar"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_detail_tagihan" />


            <!-- Tombol Cetak -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_print"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingVertical="12dp"
                android:text="Cetak Tagihan"
                app:icon="@drawable/ic_print"
                app:iconGravity="textStart"
                app:cornerRadius="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/switch_sudah_dibayar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
